from PIL import Image  # Thư viện xử lý hình ảnh (Pillow)
import os              # Thư viện làm việc với hệ điều hành (quản lý file, thư mục)

def resize_images(folder, width, height):
    """
    Hàm thay đổi kích thước toàn bộ ảnh trong một thư mục.
    :param folder: Đường dẫn đến thư mục chứa ảnh.
    :param width: Chiều rộng mới mong muốn.
    :param height: Chiều cao mới mong muốn.
# 1. Lặp qua tất cả các tên tệp tin có trong thư mục được chỉ định
    for filename in os.listdir(folder):
        
        # 2. Kiểm tra nếu tệp tin có đuôi là .jpg hoặc .png (tránh xử lý nhầm file rác)
        if filename.endswith((".jpg", ".png")):
            
            # Tạo đường dẫn đầy đủ đến file (ví dụ: "images/photo.jpg")
            img_path = os.path.join(folder, filename)
 # 3. Mở tệp tin hình ảnh
            img = Image.open(img_path)
            
            # 4. Thực hiện thay đổi kích thước ảnh theo (width, height)
            # Lưu ý: resize() nhận vào một "tuple" nên cần có 2 dấu ngoặc đơn ((w, h))
            img = img.resize((width, height))
            
            # 5. Lưu ảnh đã xử lý với tên mới (thêm tiền tố "resized_")
            # Việc này giúp tránh ghi đè lên ảnh gốc của bạn
            save_path = os.path.join(folder, "resized_" + filename)
            img.save(save_path)
            
            # Thông báo trạng thái ra màn hình
            print(f"Đã xử lý: {filename} -> {width}x{height}")
